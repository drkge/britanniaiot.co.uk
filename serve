#!/usr/bin/env bash
# Local preview. Root-relative links (/solutions/, /assets/...) only resolve when
# something serves the folder as a site root, so open it this way rather than
# double-clicking index.html.
set -e
cd "$(dirname "$0")"
PORT="${1:-4173}"
echo "Britannia IoT -> http://localhost:$PORT/  (ctrl-c to stop)"
python3 -m http.server "$PORT"
